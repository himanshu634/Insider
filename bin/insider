#!/usr/bin/env bash
# Insider dev commands for macOS.
#
#   bin/insider dev            start every service in dev mode (Ctrl-C stops all)
#   bin/insider <service>      start one service in the foreground
#   bin/insider help           list commands
#
# Postgres, Redis, the API, the worker and the web app run in Docker containers (compose.yaml);
# the database lives in the `insider_pgdata` volume. Only the collector (the macOS app) runs on
# the Mac. Collector state (fixture DB, logs) lives in .dev/ and is git-ignored.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DEV="$ROOT/.dev"
cd "$ROOT"

# --- environment ---------------------------------------------------------------------------
# A WhatsApp DB path set by the caller (make dev-real) wins over the fixture path in .env.
CALLER_WA_DB="${INSIDER_WA_DB:-}"
if [[ -f "$ROOT/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$ROOT/.env"
  set +a
fi
[[ -n "$CALLER_WA_DB" ]] && INSIDER_WA_DB="$CALLER_WA_DB"

PG_PORT="${INSIDER_PG_PORT:-54329}"
REDIS_PORT="${INSIDER_REDIS_PORT:-6380}"
API_PORT="${INSIDER_API_PORT:-8000}"
WEB_PORT="${INSIDER_WEB_PORT:-5173}"

export DATABASE_URL="${DATABASE_URL:-postgres://insider@localhost:$PG_PORT/insider}"
export REDIS_URL="${REDIS_URL:-redis://localhost:$REDIS_PORT}"
export PORT="$API_PORT"
export SENDER_HMAC_KEY="${SENDER_HMAC_KEY:-dev-sender-hmac-key}"
export AUTH_DEV_BYPASS="${AUTH_DEV_BYPASS:-true}"
export VITE_API_BASE_URL="${VITE_API_BASE_URL:-http://localhost:$API_PORT}"
export INSIDER_API_URL="${INSIDER_API_URL:-http://localhost:$API_PORT}"
export INSIDER_DEVICE_TOKEN="${INSIDER_DEVICE_TOKEN:-dev-device-token}"
export INSIDER_WA_DB="${INSIDER_WA_DB:-$DEV/fixtures/ChatStorage.sqlite}"
# .env may give a repo-relative path; the collector runs from apps/collector, so pin it here.
[[ "$INSIDER_WA_DB" == /* ]] || INSIDER_WA_DB="$ROOT/$INSIDER_WA_DB"
export INSIDER_WEB_URL="${INSIDER_WEB_URL:-http://localhost:$WEB_PORT}"

# --- helpers -------------------------------------------------------------------------------
bold() { printf '\033[1m%s\033[0m\n' "$*"; }
warn() { printf '\033[33m! %s\033[0m\n' "$*" >&2; }
die() { printf '\033[31m✗ %s\033[0m\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "$1 not found. $2"; }

need_docker() {
  need docker "Install Docker Desktop: https://docs.docker.com/desktop/setup/install/mac-install/"
  docker info >/dev/null 2>&1 || die "Docker is not running. Start Docker Desktop and try again."
}

# Run from the repo root, so compose finds compose.yaml and reads .env for ${…} values.
compose() { docker compose "$@"; }

# psql inside the Postgres container: dbsql "<sql>"
dbsql() { compose exec -T postgres psql -U insider -d insider -tAc "$1"; }

ensure_fixture_db() {
  if [[ ! -f "$INSIDER_WA_DB" ]]; then
    mkdir -p "$(dirname "$INSIDER_WA_DB")"
    sqlite3 "$INSIDER_WA_DB" < "$ROOT/packages/fixtures/chatstorage/synthetic.sql"
    echo "Built synthetic WhatsApp fixture at ${INSIDER_WA_DB#"$ROOT"/}"
  fi
}

# --- single services (foreground, in containers) -------------------------------------------
cmd_db() {
  need_docker
  bold "Postgres on localhost:$PG_PORT (container; data in the insider_pgdata volume)"
  exec docker compose up postgres
}

cmd_redis() {
  need_docker
  bold "Redis on localhost:$REDIS_PORT (container)"
  exec docker compose up redis
}

cmd_migrate() {
  # The migrate service applies the migrations and makes sure the dev-mac device exists.
  need_docker
  compose run --rm migrate
}

cmd_seed() {
  # Dev collector device whose token matches INSIDER_DEVICE_TOKEN.
  need_docker
  compose run --rm -T migrate \
    pnpm --silent --filter @insider/api create-device "dev-mac" --token "$INSIDER_DEVICE_TOKEN" >/dev/null
  echo "Dev collector device ready (token from INSIDER_DEVICE_TOKEN)"
}

cmd_create_device() {
  [[ $# -ge 1 ]] || die "Usage: bin/insider create-device <name>"
  need_docker
  # Only the token goes to stdout (enter it in the collector's Connect window); Docker's own
  # output goes to stderr.
  docker image inspect insider-dev >/dev/null 2>&1 || compose build migrate >&2
  compose run --rm -T migrate pnpm --silent --filter @insider/api create-device "$@"
}

cmd_api() {
  need_docker
  bold "API on http://localhost:$API_PORT (container)"
  exec docker compose up --build api
}

cmd_worker() {
  # BullMQ worker; also registers the IST cron schedules (aggregate, insights, brief, watchdog).
  need_docker
  exec docker compose up --build worker
}

cmd_web() {
  need_docker
  bold "Web on http://localhost:$WEB_PORT (container)"
  exec docker compose up --build web
}

cmd_collector() {
  ensure_fixture_db
  bold "Collector reading ${INSIDER_WA_DB#"$ROOT"/} → $INSIDER_API_URL"
  exec pnpm --filter @insider/collector dev
}

# --- everything (dev mode) -----------------------------------------------------------------
PIDS=()
COLORS=(36 35 32 33 34 31 96 95)

start_bg() {
  # start_bg <name> <command...>  — own process group, output prefixed with the name
  local name="$1"; shift
  local color="${COLORS[$(( ${#PIDS[@]} % ${#COLORS[@]} ))]}"
  local prefix
  prefix=$(printf '\033[%sm%-9s│\033[0m' "$color" "$name")
  set -m
  ( "$@" 2>&1 | awk -v p="$prefix" '{ print p " " $0; fflush() }' ) &
  PIDS+=("$!")
  set +m
}

stop_all() {
  trap - INT TERM EXIT
  echo
  bold "Stopping services…"
  for pid in "${PIDS[@]}"; do kill -TERM -- "-$pid" 2>/dev/null || true; done
  compose stop
  wait 2>/dev/null || true
}

# Containers in the background: build the image if needed, migrate, wait until the API is healthy.
cmd_up() {
  need_docker
  compose up --build --detach --wait api worker web
  bold "Insider containers are up — web http://localhost:$WEB_PORT · API http://localhost:$API_PORT/healthz"
}

cmd_dev() {
  local with_collector=1
  for arg in "$@"; do
    case "$arg" in
      --no-collector) with_collector=0 ;;
      *) die "Unknown option: $arg" ;;
    esac
  done

  need_docker
  trap stop_all INT TERM EXIT
  cmd_up

  # compose prefixes each line with the service name already.
  set -m
  docker compose logs --follow --tail=20 api worker web &
  PIDS+=("$!")
  set +m
  if [[ $with_collector == 1 ]]; then
    start_bg collector "$0" collector
  fi

  bold "Insider dev is up — web http://localhost:$WEB_PORT · API http://localhost:$API_PORT/healthz · Ctrl-C to stop"
  wait
}

cmd_down() {
  # Stops and removes the containers. The database volume stays.
  need_docker
  compose down
}

cmd_logs() {
  need_docker
  compose logs --follow --tail=100 "$@"
}

cmd_psql() {
  need_docker
  exec docker compose exec postgres psql -U insider -d insider
}

# One-time move: copy the database from the Homebrew cluster in .dev/postgres (used before
# Postgres ran in Docker) into the Postgres container. .dev/postgres is left as it is.
cmd_import_local_db() {
  local old="$DEV/postgres" port=54330 dump="$DEV/insider-local.dump" counts
  [[ -f "$old/PG_VERSION" ]] || die "No old cluster at .dev/postgres: nothing to import."
  need pg_ctl "Reading .dev/postgres needs the Homebrew PostgreSQL tools: brew install postgresql@18"
  if pg_ctl -D "$old" status >/dev/null 2>&1; then
    die "The old Postgres in .dev/postgres is running. Stop bin/insider dev, then: pg_ctl -D .dev/postgres stop"
  fi
  need_docker
  compose up --detach --wait postgres
  if [[ "$(dbsql "select count(*) from pg_namespace where nspname = 'market_intel'")" != 0 ]]; then
    die "The Postgres container already has Insider data. Nothing imported."
  fi

  bold "Reading .dev/postgres (temporarily on port $port)"
  # macOS: postgres refuses to start without a valid LC_ALL ("postmaster became multithreaded")
  export LC_ALL="${LC_ALL:-en_US.UTF-8}"
  pg_ctl -D "$old" -o "-p $port -k $DEV -c listen_addresses=localhost" \
    -l "$DEV/postgres-import.log" -w start >/dev/null
  counts="select (select count(*) from market_intel.collector_device) || ' devices, ' ||
    (select count(*) from market_intel.wa_group) || ' groups, ' ||
    (select count(*) from market_intel.wa_message) || ' messages'"
  if ! pg_dump -h localhost -p "$port" -U insider -Fc -f "$dump" insider; then
    pg_ctl -D "$old" -m fast -w stop >/dev/null
    die "pg_dump failed (log: .dev/postgres-import.log)"
  fi
  echo "Old cluster: $(psql -h localhost -p "$port" -U insider -d insider -tAc "$counts")"
  pg_ctl -D "$old" -m fast -w stop >/dev/null

  bold "Restoring into the Postgres container"
  compose exec -T postgres pg_restore -U insider -d insider --no-owner --exit-on-error < "$dump"
  echo "Container:   $(dbsql "$counts")"
  echo "Done. The dump is in ${dump#"$ROOT"/}; .dev/postgres is unchanged and can be deleted."
}

# --- setup, tests, codegen -----------------------------------------------------------------
cmd_setup() {
  need pnpm "Install pnpm: brew install pnpm"
  need_docker
  # On the Mac: the collector, tests, type checks and codegen. Services get their own install
  # inside the insider-dev image.
  pnpm install
  [[ -f "$ROOT/.env" ]] || { cp "$ROOT/.env.example" "$ROOT/.env"; echo "Created .env from .env.example"; }
  compose build
  echo "Done. Next: bin/insider dev"
}

cmd_test() { pnpm -r --if-present test; }

cmd_gen() { pnpm gen; }

usage() {
  cat <<EOF
Usage: bin/insider <command>

  dev [--no-collector]   Start everything: the containers (Postgres, Redis, migrations, API,
                         worker, web) and the collector on the Mac. Ctrl-C stops all
  up                     Start the containers in the background and wait until they are healthy
  down                   Stop and remove the containers (the database volume stays)
  logs [service…]        Follow container logs
  db                     Postgres container on :$PG_PORT
  redis                  Redis container on :$REDIS_PORT
  migrate                Apply database migrations (drizzle) and create the dev-mac device
  seed                   Create the dev-mac collector device
  create-device <name>   Register a collector device and print its token
  psql                   psql into the Postgres container
  api                    API container on :$API_PORT (Hono, tsx watch)
  worker                 Job worker container + IST schedules (BullMQ)
  web                    Web container on :$WEB_PORT
  collector              Collector menu-bar app (Electron, on the Mac) against the synthetic fixture DB
  import-local-db        One-time: copy the old .dev/postgres database into the Postgres container
  setup                  Install dependencies, create .env, build the dev image
  test                   Run every test suite (on the Mac)
  gen                    Regenerate types from packages/contracts/openapi.yaml
EOF
}

main() {
  local cmd="${1:-help}"
  [[ $# -gt 0 ]] && shift
  case "$cmd" in
    dev) cmd_dev "$@" ;;
    up) cmd_up ;;
    down) cmd_down ;;
    logs) cmd_logs "$@" ;;
    psql) cmd_psql ;;
    create-device) cmd_create_device "$@" ;;
    import-local-db) cmd_import_local_db ;;
    db) cmd_db ;;
    redis) cmd_redis ;;
    migrate) cmd_migrate ;;
    seed) cmd_seed ;;
    api) cmd_api ;;
    worker) cmd_worker ;;
    web) cmd_web ;;
    collector) cmd_collector ;;
    setup) cmd_setup ;;
    test) cmd_test ;;
    gen) cmd_gen ;;
    help | -h | --help) usage ;;
    *) usage; die "Unknown command: $cmd" ;;
  esac
}

main "$@"

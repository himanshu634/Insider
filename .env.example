# Copy to .env (bin/insider setup does this). bin/insider and the API load it automatically.

# --- API service ---
# Local dev: bin/insider db runs Postgres on 54329 with this URL.
DATABASE_URL=postgres://insider@localhost:54329/insider
# Supabase example (all Insider tables live in schema market_intel):
# DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
PORT=8000
# 127.0.0.1 by default; Nginx fronts the API in production
HOST=127.0.0.1

REDIS_URL=redis://localhost:6380
# true = run pipeline jobs inline in the API (no Redis / worker needed)
QUEUE_INLINE=false

# HMAC key for sender JIDs (the collector uses the same key) — any long random string
SENDER_HMAC_KEY=change-me
# Dev only: lets the web app call user endpoints without real login
AUTH_DEV_BYPASS=true

GCS_MEDIA_BUCKET=insider-media-dev
# Leave empty in dev: media uploads get a local placeholder URL instead of a signed GCS URL
GCP_PROJECT=
CORS_ORIGINS=http://localhost:5173

# --- Web ---
VITE_API_BASE_URL=http://localhost:8000

# --- Collector (dev) ---
INSIDER_API_URL=http://localhost:8000
INSIDER_DEVICE_TOKEN=dev-device-token
# Points the collector at the synthetic fixture instead of the real WhatsApp DB
INSIDER_WA_DB=.dev/fixtures/ChatStorage.sqlite
INSIDER_WEB_URL=http://localhost:5173
